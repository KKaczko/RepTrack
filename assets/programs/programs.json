{
  "formatVersion": 1,
  "programs": [
    {
      "id": "fbw_beginner_3",
      "name": {"pl": "FBW na start (3× w tygodniu)", "en": "Full body starter (3× a week)"},
      "description": {
        "pl": "Trzy różne treningi całego ciała na siłowni: przysiad, wyciskanie, wiosłowanie, martwy ciąg rumuński i brzuch. Dobry pierwszy plan; ciężar rośnie sam, gdy dojdziesz do góry zakresu powtórzeń.",
        "en": "Three different full-body gym workouts: squat, press, row, Romanian deadlift and core. A good first plan; the weight goes up by itself once you reach the top of the rep range."
      },
      "level": "beginner",
      "equipment": "gym",
      "schedule": {"1": "A", "3": "B", "5": "C"},
      "workouts": [
        {
          "key": "A",
          "name": {"pl": "FBW A", "en": "Full body A"},
          "exercises": [
            {"exercise": "back_squat", "sets": 3, "reps": [6, 10], "rest": 150},
            {"exercise": "dumbbell_bench_press", "sets": 3, "reps": [8, 12], "rest": 120},
            {"exercise": "seated_cable_row", "sets": 3, "reps": [8, 12], "rest": 120},
            {"exercise": "dumbbell_shoulder_press", "sets": 2, "reps": [8, 12], "rest": 90},
            {"exercise": "plank", "sets": 3, "seconds": [30, 60], "rest": 60}
          ]
        },
        {
          "key": "B",
          "name": {"pl": "FBW B", "en": "Full body B"},
          "exercises": [
            {"exercise": "romanian_deadlift", "sets": 3, "reps": [8, 10], "rest": 150},
            {"exercise": "lat_pulldown", "sets": 3, "reps": [8, 12], "rest": 120},
            {"exercise": "incline_dumbbell_press", "sets": 3, "reps": [8, 12], "rest": 120},
            {"exercise": "split_squat", "sets": 2, "reps": [8, 12], "rest": 90},
            {"exercise": "dead_bug", "sets": 3, "reps": [8, 12], "rest": 60}
          ]
        },
        {
          "key": "C",
          "name": {"pl": "FBW C", "en": "Full body C"},
          "exercises": [
            {"exercise": "leg_press", "sets": 3, "reps": [10, 12], "rest": 120},
            {"exercise": "machine_chest_press", "sets": 3, "reps": [8, 12], "rest": 120},
            {"exercise": "dumbbell_row", "sets": 3, "reps": [8, 12], "rest": 90},
            {"exercise": "lateral_raise", "sets": 3, "reps": [12, 15], "rest": 60},
            {"exercise": "dumbbell_curl", "sets": 2, "reps": [10, 12], "rest": 60, "superset": "ramiona"},
            {"exercise": "triceps_pushdown", "sets": 2, "reps": [10, 12], "rest": 60, "superset": "ramiona"}
          ]
        }
      ]
    },
    {
      "id": "strength_5x5",
      "name": {"pl": "Siła 5×5", "en": "Strength 5×5"},
      "description": {
        "pl": "Klasyczny plan siłowy ze sztangą: mało ćwiczeń, ciężkie serie po 5 powtórzeń. Gdy zrobisz wszystkie serie po 5, następnym razem ciężar rośnie o krok. Treningi A i B na zmianę: pon. A, śr. B, pt. A.",
        "en": "A classic barbell strength plan: few exercises, heavy sets of 5. Once you complete every set of 5, the weight goes up by one step next time. Workouts A and B alternate: Mon A, Wed B, Fri A."
      },
      "level": "beginner",
      "equipment": "gym",
      "schedule": {"1": "A", "3": "B", "5": "A"},
      "workouts": [
        {
          "key": "A",
          "name": {"pl": "5×5 A", "en": "5×5 A"},
          "exercises": [
            {"exercise": "back_squat", "sets": 5, "reps": [5, 5], "rest": 180},
            {"exercise": "barbell_bench_press", "sets": 5, "reps": [5, 5], "rest": 180},
            {"exercise": "barbell_row", "sets": 5, "reps": [5, 5], "rest": 150}
          ]
        },
        {
          "key": "B",
          "name": {"pl": "5×5 B", "en": "5×5 B"},
          "exercises": [
            {"exercise": "back_squat", "sets": 5, "reps": [5, 5], "rest": 180},
            {"exercise": "overhead_press", "sets": 5, "reps": [5, 5], "rest": 180},
            {"exercise": "deadlift", "sets": 1, "reps": [5, 5], "rest": 180}
          ]
        }
      ]
    },
