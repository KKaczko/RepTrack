<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup i przenoszenie na nowy telefon od Androida 12
     (ADR 0008): tylko baza danych, jak w backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="reptrack.sqlite" />
        <include domain="file" path="reptrack.sqlite-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="reptrack.sqlite" />
        <include domain="file" path="reptrack.sqlite-wal" />
    </device-transfer>
</data-extraction-rules>
