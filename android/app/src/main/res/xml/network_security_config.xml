<?xml version="1.0" encoding="utf-8"?>
<!-- Asystent AI (ADR 0014): Ollama w sieci domowej mówi po HTTP, a adres
     (np. 192.168.1.10) wpisuje użytkownik, więc system nie może go znać
     z góry i ruch bez TLS jest tu dozwolony. Bramka jest w aplikacji:
     http tylko do adresów lokalnych i Tailscale (isAllowedServer w
     lib/features/assistant/domain/assistant.dart), adres publiczny wymaga
     https. Aplikacja łączy się tylko z adresem z ustawień. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
